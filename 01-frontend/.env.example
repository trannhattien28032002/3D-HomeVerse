VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_API_URL=http://localhost:3000
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Base URL phục vụ catalog asset (models/materials/thumbnails/hdri) từ CDN.
# RỖNG = dùng asset tĩnh trong public/ (mặc định dev). Khi đã upload lên Supabase
# Storage (migration 016 + scripts/upload-catalog-assets.mjs), trỏ tới:
#   https://<project-ref>.supabase.co/storage/v1/object/public/catalog-assets
VITE_ASSET_BASE_URL=

# CHỈ dùng cho scripts/upload-catalog-assets.mjs (KHÔNG đưa vào FE bundle).
# Lấy từ Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

