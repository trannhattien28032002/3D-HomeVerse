# Used by docker-compose.yml for port mapping and frontend build args.
# Copy to .env (gitignored) and fill in real values before `docker compose build`.
# Backend secrets live separately in 02-backend/properties.dev.env (see
# 02-backend/properties.dev.env.example) — that file is loaded via env_file, not here.

BACKEND_PORT=3000
FRONTEND_PORT=8080

# Frontend build-time vars — baked into the static bundle, so the frontend
# image must be rebuilt whenever these change.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3000
VITE_CLOUDINARY_CLOUD_NAME=
VITE_ASSET_BASE_URL=
